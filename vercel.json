{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/render.js": {
            "includeFiles": ".env"
        },
        "api/sitemap.js": {
            "includeFiles": ".env"
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "lexenegal.sn"
                }
            ],
            "destination": "https://www.lexenegal.sn/:path*",
            "permanent": true
        },
        {
            "source": "/code/code-des-obligations-civiles-et-commerciales",
            "destination": "/code/cocc",
            "permanent": true
        },
        {
            "source": "/code/code-des-obligations-civiles-et-commerciales/:path*",
            "destination": "/code/cocc",
            "permanent": true
        },
        {
            "source": "/decision/ohada-j-02-30",
            "destination": "/decision/conseil-constitutionnel-19931216-3-c-93",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap?seg=index"
        },
        {
            "source": "/sitemap-:seg.xml",
            "destination": "/api/sitemap?seg=:seg"
        },
        {
            "source": "/codes",
            "destination": "/api/render?type=codes"
        },
        {
            "source": "/decision/:slug",
            "destination": "/api/render?type=decision&slug=:slug"
        },
        {
            "source": "/code/:codeSlug/:articleSlug",
            "destination": "/api/render?type=article&code=:codeSlug&slug=:articleSlug"
        },
        {
            "source": "/code/:slug",
            "destination": "/api/render?type=code&slug=:slug"
        },
        {
            "source": "/doctrine-fiscale/:slug",
            "destination": "/api/render?type=doctrine&slug=:slug"
        },
        {
            "source": "/jurisprudence/theme/:slug",
            "destination": "/api/render?type=theme&slug=:slug"
        },
        {
            "source": "/jurisprudence",
            "destination": "/api/render?type=jurisprudence"
        },
        {
            "source": "/guides/:slug",
            "destination": "/api/render?type=guide&slug=:slug"
        },
        {
            "source": "/guides",
            "destination": "/api/render?type=guides"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}